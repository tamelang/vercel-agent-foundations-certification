# Copy to .env.local and fill in. Everything here is server-only — never add a NEXT_PUBLIC_ prefix.

# Store API (Vercel deployment-protection bypass). Sent as x-vercel-protection-bypass.
BYPASS_SECRET=
# Optional. Defaults to https://vercel-agentic-swag-store-api.vercel.app/api
# API_BASE_URL=

# Vercel AI Gateway (both agents). Either set an API key, or run
# `vercel link && vercel env pull` to get a VERCEL_OIDC_TOKEN (also used by Sandbox).
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Vercel Sandbox (admin agent bash + memory). Not needed when VERCEL_OIDC_TOKEN is set.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# Optional: name of the persistent admin sandbox (default ship-it-shop-admin).
# ADMIN_SANDBOX_NAME=

# Optional model overrides (AI Gateway provider/model IDs).
# SHOP_AGENT_MODEL=nvidia/nemotron-3.5-lightning-free
# ADMIN_AGENT_MODEL=nvidia/nemotron-3.5-lightning-free
